# Your client public IPv4, not the EC2 address. Documentation example only.
IP_ADDRESS=203.0.113.10

# Optional existing SecureString parameter NAME, never the password itself.
# Leave blank to use the EC2 IAM role directly with s3fs.
PARAM_STORE_KEY_S3_PASSWD=
# Only needed for a customer-managed KMS key protecting that parameter.
S3_PASSWD_KMS_KEY_ARN=

# Optional PUBLIC key file, with one or more OpenSSH public keys (never private keys).
# Example: ~/.ssh/id_ed25519.pub; relative paths resolve from the project directory.
SSH_PUBLIC_KEYS_FILE=
