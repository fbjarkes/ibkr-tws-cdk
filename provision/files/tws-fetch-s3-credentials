#!/usr/bin/env bash
# Runs on EC2 only. Never enable xtrace or print the decrypted response.
set +x
set -euo pipefail
if [ -z "${PARAM_STORE_KEY_S3_PASSWD:-}" ]; then exit 0; fi
umask 077
directory=$(mktemp -d /run/tws-s3-credentials.XXXXXX)
trap 'rm -rf -- "$directory"' EXIT
aws ssm get-parameter --name "$PARAM_STORE_KEY_S3_PASSWD" --with-decryption --region "$AWS_DEFAULT_REGION" --output json > "$directory/response.json"
python3 - "$directory/response.json" "$directory/passwd-s3fs" <<'PY'
import json, os, re, sys
with open(sys.argv[1], encoding="utf-8") as source:
    parameter = json.load(source)["Parameter"]
if parameter.get("Type") != "SecureString":
    raise SystemExit("s3fs credentials must use a SecureString parameter")
value = parameter["Value"].rstrip("\r\n")
if not re.fullmatch(r"[^:\s]+:[^:\s]+", value):
    raise SystemExit("Invalid s3fs credential format; expected ACCESS_KEY_ID:SECRET_ACCESS_KEY")
with open(sys.argv[2], "x", encoding="utf-8") as target:
    os.chmod(sys.argv[2], 0o600)
    target.write(value + "\n")
PY
# Atomic replacement; a failed refresh fails startup rather than using an old secret.
install -o root -g root -m 0600 "$directory/passwd-s3fs" /etc/passwd-s3fs.new
mv -f /etc/passwd-s3fs.new /etc/passwd-s3fs
