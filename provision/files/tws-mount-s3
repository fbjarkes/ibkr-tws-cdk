#!/usr/bin/env bash
set +x
set -euo pipefail
bucket="$S3_BUCKET"
if [ -n "$S3_PREFIX" ]; then bucket="$bucket:/${S3_PREFIX%/}"; fi
# Temporary credentials from the EC2 instance role, scoped to the bucket/prefix in CDK.
options=(-o iam_role=auto -o "endpoint=$S3_REGION" -o "url=https://s3.$S3_REGION.amazonaws.com" -o use_path_request_style -o allow_other -o "uid=$(id -u trader)" -o "gid=$(id -g trader)" -o mp_umask=022 -o compat_dir)
if [ "$S3_WRITABLE" != true ]; then options+=(-o ro); fi
exec /usr/bin/s3fs "$bucket" /mnt/watchlists -f "${options[@]}"
